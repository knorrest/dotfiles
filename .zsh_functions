# Create (or attach to) a session group
tsg () {
  local session=$1
  if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -s "$session"
    else
      tmux new-session -t "$session" \; set-option destroy-unattached
    fi
}

# Apply the window/pane layout from ~/.tmux/<name>.conf to the current session
tsl () {
  tmux source-file "$HOME/.tmux/${1}.conf"
}

